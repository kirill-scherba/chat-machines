# Chat Machines — Environment Variables
# Copy to ~/.config/chat-machines/env

# HTTP MCP transport address
CM_HTTP=:8083

# External Chat Connector (ECC) address
CM_EXTERNAL_ADDR=:8084

# Base URL for external participant links (ECC)
CM_EXTERNAL_BASE_URL=https://chat.bmat.uk

# API key for Bearer auth on /room/create endpoint
# Generate with: openssl rand -hex 16
CM_API_KEY=

# opencode-serve HTTP API URL
CM_OPENCODE_URL=http://127.0.0.1:7709

# Per-message timeout for AI responses (default: 2m)
CM_TIMEOUT=5m

# Human adjunct response timeout (default: 5m)
CM_ADJUNCT_TIMEOUT=5m

# Log output directory (empty = stderr only)
CM_LOG_DIR=/tmp/chat-machines/logs

# SQLite database path for optional message logging (empty = no persistence)
CM_DB=
